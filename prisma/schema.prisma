// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   
  name      String?
  createdAt DateTime @default(now())
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String   @db.Text
  price          Float
  compareAtPrice Float?   // Optional field for the crossed-out sale price
  category       String   
  image          String   // Main thumbnail
  gallery        String[] // Array of extra image URLs
  sizes          String[] 
  inStock        Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  isNewArrival   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- UPGRADED MODELS FOR STOREFRONT CONTROL ---

model InstaPost {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String?  // Optional link if you want them to click to Instagram
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  name        String
  productName String   // e.g., "Signature Oud Blend"
  rating      Int      @default(5)
  comment     String   @db.Text
  isPublished Boolean  @default(true) // Allows Admin to approve/hide reviews
  createdAt   DateTime @default(now())
}

// Single-row table to control global website settings
model StoreSettings {
  id               String   @id @default("saaf-settings") 
  announcementText String   @default("Complimentary Global Shipping on Orders over ₹5000")
  isAnnouncementOn Boolean  @default(true) // Toggle the top black bar on/off
  freeShippingGoal Float    @default(5000) // Controls the cart math dynamically
  updatedAt        DateTime @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}